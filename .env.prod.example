# Template for docker-compose.prod.yml deployments (see DEPLOY.md).
# Different from .env.example: DATABASE_HOST/REDIS_URL point at the
# "db"/"redis" container service names, not localhost -- the app itself
# runs inside the same compose network as them here, instead of on the
# host machine like in local dev.
#
# Copy to .env on the server, then replace every "change-me".

DJANGO_SECRET_KEY=change-me-generate-a-real-secret-key
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=change-me-your-ec2-public-dns-or-domain

# HTTPS via the "caddy" service in docker-compose.prod.yml (free
# Let's Encrypt certificate, auto-renewed). Leave DJANGO_USE_HTTPS=False
# (or omit "caddy" from the compose stack entirely) for a plain-HTTP
# deployment -- both are supported. CADDY_DOMAIN needs to be a real
# domain whose DNS already points at this host's public IP; Let's
# Encrypt cannot issue a certificate for a bare IP address.
DJANGO_USE_HTTPS=False
DJANGO_CSRF_TRUSTED_ORIGINS=https://change-me.example.com
CADDY_DOMAIN=change-me.example.com

DATABASE_NAME=events_db
DATABASE_USER=events_user
DATABASE_PASSWORD=change-me
DATABASE_HOST=db
DATABASE_PORT=5432

REDIS_URL=redis://redis:6379/0
REDIS_THROTTLE_TEST_URL=redis://redis:6379/15

JWT_ACCESS_TOKEN_LIFETIME_MINUTES=15
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

AUTH_LOGIN_RATE=10/min
AUTH_SIGNUP_RATE=5/hour
AUTH_RESEND_OTP_RATE=5/hour
