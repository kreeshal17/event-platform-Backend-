DJANGO_SECRET_KEY=change-me-generate-a-real-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

DATABASE_NAME=events_db
DATABASE_USER=events_user
DATABASE_PASSWORD=change-me
DATABASE_HOST=localhost
DATABASE_PORT=5433

JWT_ACCESS_TOKEN_LIFETIME_MINUTES=15
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# Redis: shared cache backend, used for DRF throttle state only.
# Never used to store OTPs — OTP data lives in PostgreSQL (EmailOTP model).
REDIS_URL=redis://localhost:6379/0
REDIS_PORT=6379

AUTH_LOGIN_RATE=10/min
AUTH_SIGNUP_RATE=5/hour
AUTH_RESEND_OTP_RATE=5/hour
